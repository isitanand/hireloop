# Copy to backend/.env and fill in. Nothing here is required to run the
# backend in demo mode (--scorer keyword needs no LLM key at all).

# --- database -----------------------------------------------------------
# Leave unset for local SQLite (backend/data/jobhunt.db). In production,
# point at a free Postgres instance (Neon, Supabase, Render Postgres):
# DATABASE_URL=postgresql://user:pass@host/dbname
DATABASE_URL=

# --- auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
ADMIN_RUN_SECRET=change-me-too-used-by-the-github-actions-cron

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM provider (shared across all users - see README for free tiers) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
SCREEN_MODEL=gemini-3.6-flash
DRAFT_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Every Gemini call already retries a couple of times on its own for
# transient "high demand" 503s (see jobhunt/providers.py) - that alone
# covers most rate-limit blips. Optionally, ALSO name a second model here
# (same provider) to fall back to if the primary is down for longer than
# that: a batch that still fails on SCREEN_MODEL gets one more attempt on
# this before being skipped. Unset by default.
# SCREEN_FALLBACK_MODEL=gemini-2.5-flash
# DRAFT_FALLBACK_MODEL=gemini-2.5-flash

# --- outgoing email (optional - users can still use the site without it) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
